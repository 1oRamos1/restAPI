# Copy this file to `.env` (same folder) and fill in real values:
#   cp mysite/.env.example mysite/.env
# `.env` is gitignored - never commit real keys.
#
# docker-compose.yml already sets DATABASE_URL, IS_PRODUCTION, SERVE_FRONTEND,
# DB_SSL and the DJANGO_SUPERUSER_* values for you, so they are not needed here.
# All variables below are REQUIRED: Django will not start if one is missing.

# Django secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
SOCIAL_AUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SOCIAL_AUTH_GOOGLE_SECRET=your-google-client-secret

# AI providers
# Mistral is used for free users, OpenAI (needs billing credits) for pro users.
OPENAI_API_KEY=sk-your-openai-api-key
MISTRAL_API_KEY=your-mistral-api-key

# PayPal (sandbox credentials are fine for local development)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret

# Optional - defaults shown
# LOGIN_REDIRECT_URL=/
# LOGOUT_REDIRECT_URL=/login
